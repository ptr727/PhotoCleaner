{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        },
        {
            "name": "PhotoCleaner Process",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": ".Net Build",
            "program": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0/PhotoCleaner.dll",
            "args": [
                "process",
                "--path=/data/media/Temp/Organized",
                "--db=/data/media/Temp/Organized/PhotoCleaner.db",
                "--threads=8",
                "--skipbackup=true",
                "--dryrun=false",
                "--loglevel=verbose",
                "--logfile=PhotoCleaner.log",
                "--logclear=true"
            ],
            "cwd": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Undo",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": ".Net Build",
            "program": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0/PhotoCleaner.dll",
            "args": [
                "undo",
                "--path=/data/media/Temp/Organized",
                "--dryrun=false",
                "--loglevel=verbose",
                "--logfile=PhotoCleaner.log",
                "--logclear=true"
            ],
            "cwd": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Cleanup",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": ".Net Build",
            "program": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0/PhotoCleaner.dll",
            "args": [
                "cleanup",
                "--path=/data/media/Temp/Organized",
                "--dryrun=false",
                "--loglevel=verbose",
                "--logfile=PhotoCleaner.log",
                "--logclear=true"
            ],
            "cwd": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Organize",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": ".Net Build",
            "program": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0/PhotoCleaner.dll",
            "args": [
                "organize",
                "--path=/data/media/Temp/UnOrganized",
                "--outpath=/data/media/Temp/Organized",
                "--deleteempty=true",
                "--move=false",
                "--format=yyyy/MM/yyyy-MM-dd",
                "--datepath=true",
                "--tagpath=true",
                "--tags=space in name, nospace",
                "--db=/data/media/Temp/Organized/PhotoCleaner.db",
                "--threads=8",
                "--dryrun=false",
                "--loglevel=verbose",
                "--logfile=PhotoCleaner.log",
                "--logclear=true"
            ],
            "cwd": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false
        },
    ]
}
