{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        },
        {
            "name": "Trash DB",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": ".NET Build",
            "program": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0/PhotoCleaner.dll",
            "args": [
                "trash",
                "--url=http://localhost:2283",
                "--trashdb=/photos/db/trash.db",
                "--apikey-file=${workspaceFolder}/.secrets/immich_api_key",
                "--loglevel=verbose",
                "--logfile=/photos/db/trash.log",
                "--logclear=true"
            ],
            "cwd": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Skip DB",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": ".NET Build",
            "program": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0/PhotoCleaner.dll",
            "args": [
                "index",
                "--path=/photos/skip",
                "--db=/photos/db/skip.db",
                "--rehash=false",
                "--threads=4",
                "--loglevel=verbose",
                "--logfile=/photos/db/skip.log",
                "--logclear=true"
            ],
            "cwd": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Import",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": ".NET Build",
            "program": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0/PhotoCleaner.dll",
            "args": [
                "import",
                "--path=/photos/originals",
                "--outpath=/photos/processed",
                "--deleteempty=true",
                "--move=false",
                "--format=yyyy/MM/yyyy-MM-dd",
                "--datepath=true",
                "--tagpath=true",
                "--tags=space in name, nospace",
                "--db=/photos/db/import.db",
                "--trashdb=/photos/db/trash.db",
                "--skipdb=/photos/db/skip.db",
                "--rehash=false",
                "--threads=4",
                "--dryrun=false",
                "--loglevel=verbose",
                "--logfile=/photos/db/import.log",
                "--logclear=true"
            ],
            "cwd": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Process",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": ".NET Build",
            "program": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0/PhotoCleaner.dll",
            "args": [
                "process",
                "--path=/photos/processed",
                "--db=/photos/db/process.db",
                "--trashdb=/photos/db/trash.db",
                "--rehash=false",
                "--duration=1",
                "--threads=4",
                "--skipbackup=false",
                "--deleteempty=true",
                "--dryrun=false",
                "--loglevel=verbose",
                "--logfile=/photos/db/process.log",
                "--logclear=true"
            ],
            "cwd": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Verify",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": ".NET Build",
            "program": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0/PhotoCleaner.dll",
            "args": [
                "verify",
                "--path=/photos/originals",
                "--db=/photos/db/verify.db",
                "--rehash=false",
                "--reprocess=true",
                "--threads=4",
                "--loglevel=verbose",
                "--logfile=/photos/db/verify.log",
                "--logclear=true"
            ],
            "cwd": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Verify No Database",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": ".NET Build",
            "program": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0/PhotoCleaner.dll",
            "args": [
                "verify",
                "--path=/photos/originals",
                "--threads=4",
                "--loglevel=verbose",
                "--logfile=/photos/db/verify.log",
                "--logclear=true"
            ],
            "cwd": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Undo",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": ".NET Build",
            "program": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0/PhotoCleaner.dll",
            "args": [
                "undo",
                "--path=/photos/processed",
                "--dryrun=false",
                "--loglevel=verbose",
                "--logfile=/photos/db/undo.log",
                "--logclear=true"
            ],
            "cwd": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false
        }
    ]
}
