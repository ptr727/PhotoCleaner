{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        },
        {
            "name": "Trash DB",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": ".Net Build",
            "program": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0/PhotoCleaner.dll",
            "args": [
                "trash",
                "--url=https://immich.home.insanegenius.net/",
                "--trashdb=/data/media/PhotoCleaner/Trash.db",
                "--apikey-file=${workspaceFolder}/secrets/immich_api_key.txt",
                "--loglevel=verbose",
                "--logfile=/data/media/PhotoCleaner/Trash.log",
                "--logclear=true"
            ],
            "cwd": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Skip DB",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": ".Net Build",
            "program": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0/PhotoCleaner.dll",
            "args": [
                "index",
                "--path=/data/media/PhotoCleaner/Originals/Skip",
                "--db=/data/media/PhotoCleaner/Skip.db",
                "--rehash=false",
                "--threads=4",
                "--loglevel=verbose",
                "--logfile=/data/media/PhotoCleaner/Skip.log",
                "--logclear=true"
            ],
            "cwd": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Import",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": ".Net Build",
            "program": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0/PhotoCleaner.dll",
            "args": [
                "import",
                "--path=/data/media/PhotoCleaner/Originals",
                "--outpath=/data/media/PhotoCleaner/Processed",
                "--deleteempty=true",
                "--move=false",
                "--format=yyyy/MM/yyyy-MM-dd",
                "--datepath=true",
                "--tagpath=true",
                "--tags=space in name, nospace",
                "--db=/data/media/PhotoCleaner/Processed/Import.db",
                "--trashdb=/data/media/PhotoCleaner/Trash.db",
                "--skipdb=/data/media/PhotoCleaner/Skip.db",
                "--rehash=false",
                "--threads=4",
                "--dryrun=false",
                "--loglevel=verbose",
                "--logfile=/data/media/PhotoCleaner/Processed/Import.log",
                "--logclear=true"
            ],
            "cwd": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Process",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": ".Net Build",
            "program": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0/PhotoCleaner.dll",
            "args": [
                "process",
                "--path=/data/media/PhotoCleaner/Processed",
                "--db=/data/media/PhotoCleaner/Processed/Process.db",
                "--trashdb=/data/media/PhotoCleaner/Trash.db",
                "--rehash=false",
                "--duration=1",
                "--threads=4",
                "--skipbackup=false",
                "--deleteempty=true",
                "--dryrun=false",
                "--loglevel=verbose",
                "--logfile=/data/media/PhotoCleaner/Processed/Process.log",
                "--logclear=true"
            ],
            "cwd": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Undo",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": ".Net Build",
            "program": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0/PhotoCleaner.dll",
            "args": [
                "undo",
                "--path=/data/media/PhotoCleaner/Processed",
                "--dryrun=false",
                "--loglevel=verbose",
                "--logfile=/data/media/PhotoCleaner/Processed/Undo.log",
                "--logclear=true"
            ],
            "cwd": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false
        }
    ]
}
