{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        },
        {
            "name": "Trash DB",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": ".NET Build",
            "program": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0/PhotoCleaner.dll",
            "args": [
                "trash",
                "--url=http://immich:2283",
                "--trashdb=/photos/Trash.db",
                "--apikey-file=${workspaceFolder}/.secrets/immich_api_key",
                "--loglevel=verbose",
                "--logfile=/photos/Trash.log",
                "--logclear=true"
            ],
            "cwd": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Skip DB",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": ".NET Build",
            "program": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0/PhotoCleaner.dll",
            "args": [
                "index",
                "--path=/photos/Originals/Skip",
                "--db=/photos/Skip.db",
                "--rehash=false",
                "--threads=4",
                "--loglevel=verbose",
                "--logfile=/photos/Skip.log",
                "--logclear=true"
            ],
            "cwd": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Import",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": ".NET Build",
            "program": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0/PhotoCleaner.dll",
            "args": [
                "import",
                "--path=/photos/Originals",
                "--outpath=/photos/Processed",
                "--deleteempty=true",
                "--move=false",
                "--format=yyyy/MM/yyyy-MM-dd",
                "--datepath=true",
                "--tagpath=true",
                "--tags=space in name, nospace",
                "--db=/photos/Processed/Import.db",
                "--trashdb=/photos/Trash.db",
                "--skipdb=/photos/Skip.db",
                "--rehash=false",
                "--threads=4",
                "--dryrun=false",
                "--loglevel=verbose",
                "--logfile=/photos/Processed/Import.log",
                "--logclear=true"
            ],
            "cwd": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Process",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": ".NET Build",
            "program": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0/PhotoCleaner.dll",
            "args": [
                "process",
                "--path=/photos/Processed",
                "--db=/photos/Processed/Process.db",
                "--trashdb=/photos/Trash.db",
                "--rehash=false",
                "--duration=1",
                "--threads=4",
                "--skipbackup=false",
                "--deleteempty=true",
                "--dryrun=false",
                "--loglevel=verbose",
                "--logfile=/photos/Processed/Process.log",
                "--logclear=true"
            ],
            "cwd": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Verify",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": ".NET Build",
            "program": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0/PhotoCleaner.dll",
            "args": [
                "verify",
                "--path=/photos/Originals",
                "--db=/photos/Verify.db",
                "--rehash=false",
                "--reprocess=true",
                "--threads=4",
                "--loglevel=verbose",
                "--logfile=/photos/Verify.log",
                "--logclear=true"
            ],
            "cwd": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Verify No Database",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": ".NET Build",
            "program": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0/PhotoCleaner.dll",
            "args": [
                "verify",
                "--path=/photos/Originals",
                "--threads=4",
                "--loglevel=verbose",
                "--logfile=/photos/Verify.log",
                "--logclear=true"
            ],
            "cwd": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Undo",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": ".NET Build",
            "program": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0/PhotoCleaner.dll",
            "args": [
                "undo",
                "--path=/photos/Processed",
                "--dryrun=false",
                "--loglevel=verbose",
                "--logfile=/photos/Processed/Undo.log",
                "--logclear=true"
            ],
            "cwd": "${workspaceFolder}/PhotoCleaner/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false
        }
    ]
}
