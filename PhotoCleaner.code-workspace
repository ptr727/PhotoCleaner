{
    "folders": [
        {
            "path": "."
        }
    ],
    "settings": {
        "dotnet.defaultSolution": "PhotoCleaner.slnx",
        "files.trimTrailingWhitespace": true,
        "[markdown]": {
            "files.trimTrailingWhitespace": false
        },
        "[plaintext]": {
            "files.trimTrailingWhitespace": false
        },
        "[csharp]": {
            "editor.formatOnSave": true,
            "editor.defaultFormatter": "csharpier.csharpier-vscode"
        },
        "[json][jsonc]": {
            "editor.defaultFormatter": "vscode.json-language-features"
        },
        "diffEditor.ignoreTrimWhitespace": false,
        "editor.renderWhitespace": "boundary",
        "dotnet.formatting.organizeImportsOnFormat": true,
        "csharp.debug.symbolOptions.searchNuGetOrgSymbolServer": true,
        "csharp.debug.symbolOptions.searchMicrosoftSymbolServer": true,
        "files.encoding": "utf8",
        "csharp.debug.justMyCode": false
    },
    "extensions": {
        "recommendations": [
            "csharpier.csharpier-vscode",
            "davidanson.vscode-markdownlint",
            "editorconfig.editorconfig",
            "fanaticpythoner.better-todo-tree",
            "github.vscode-github-actions",
            "ms-azuretools.vscode-docker",
            "ms-dotnettools.csdevkit",
            "streetsidesoftware.code-spell-checker",
            "yzhang.markdown-all-in-one"
        ]
    }
}
