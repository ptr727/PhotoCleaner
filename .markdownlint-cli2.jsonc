{
    "config": {
        // Prose paragraphs and data-heavy tables/URLs are intentionally long;
        // reflowing at 80 cols hurts readability and churns diffs.
        "MD013": false,
        // Repeated per-OS subsections (Install/Update -> Windows/Linux/.NET Tools)
        // are legitimate under different parents; only flag true same-parent dupes.
        "MD024": { "siblings_only": true },
        // Inline HTML is used for reference-link section dividers.
        "MD033": false,
        // Require fenced code blocks over the legacy 4-space-indented style.
        "MD046": { "style": "fenced" },
        // MD060 (table column style) is not enforced.
        "MD060": false
    },
    "gitignore": true
}
