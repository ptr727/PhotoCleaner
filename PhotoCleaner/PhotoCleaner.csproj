<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <InformationalVersion>1.0.0-pre</InformationalVersion>
    <OutputType>Exe</OutputType>
    <PublishAot>false</PublishAot>
    <RootNamespace>PhotoCleaner</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained>true</SelfContained>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PhotoCleanerTests" />
    <InternalsVisibleTo Include="PhotoCleanerBenchmarks" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CliWrap" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Direct reference overrides the vulnerable transitive SQLitePCLRaw (GHSA-2m69-gcr7-jv3q); version in Directory.Packages.props -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="ptr727.Utilities" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
</Project>
